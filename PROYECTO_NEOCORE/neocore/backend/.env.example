# ============================================================================
# NeoCore Backend — Variables de Entorno
# ============================================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a git.
#
# Para producción en Vercel, configura estas variables en:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================================

# ============================================================================
# SEGURIDAD (OBLIGATORIO en producción)
# ============================================================================

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIA-ESTO-EN-PRODUCCION

# Clave de cifrado de campos sensibles (teléfono, notas, etc.). Genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CAMBIA-ESTO-EN-PRODUCCION

# Modo debug (False en producción siempre)
DEBUG=False

# ============================================================================
# BASE DE DATOS — Neon PostgreSQL
# ============================================================================
# Obtén la cadena de conexión en: console.neon.tech → Project → Connection Details
# Formato: postgresql://user:password@host/database?sslmode=require
#
# IMPORTANTE: Después de configurar DATABASE_URL, ejecuta las migraciones:
#   vercel exec -- python manage.py migrate
#   # o localmente con las variables en .env:
#   python manage.py migrate
DATABASE_URL=postgresql://neondb_owner:PASS@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# DOMINIO / URLS (configura los tuyos)
# ============================================================================

# URL pública del backend (Vercel backend project URL)
BACKEND_PUBLIC_URL=https://neocore-api.vercel.app

# URL pública del frontend (Vercel frontend project URL)
FRONTEND_URL=https://neocore.vercel.app

# Dominio personalizado del frontend (si tienes uno)
NEXT_PUBLIC_DOMAIN=https://neocoree.xyz

# Hosts adicionales permitidos (separados por coma)
ALLOWED_HOSTS=

# Orígenes CORS adicionales (separados por coma)
CORS_ALLOWED_ORIGINS=

# ============================================================================
# ADMINISTRACIÓN
# ============================================================================

# Ruta del panel de administración real (por seguridad, no usar /admin/)
ADMIN_PATH=tu-ruta-admin-secreta/

# IPs permitidas para acceder al panel de admin (dejar vacío = sin restricción de IP)
# Ejemplo: 203.0.113.10,203.0.113.20
ADMIN_ALLOWED_IPS=

# ============================================================================
# EMAIL
# ============================================================================

# Backend de email: usa console para dev, smtp para prod
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configuración SMTP (ejemplo con Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_de_gmail

# Email del remitente por defecto
DEFAULT_FROM_EMAIL=NeoCore <noreply@neocoree.xyz>

# Email receptor de los mensajes de contacto
CONTACT_RECIPIENT_EMAIL=admin@neocoree.xyz

# ============================================================================
# AUTENTICACIÓN SOCIAL (opcional)
# ============================================================================

# Google OAuth (configura en console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# CELERY + REDIS (opcional — degradación elegante si no está configurado)
# ============================================================================

# Redis URL para Celery (tareas asíncronas y caché)
# Ejemplo con Upstash Redis: rediss://:password@hostname:6380
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ============================================================================
# INTERNACIONALIZACIÓN
# ============================================================================
LANGUAGE_CODE=es
TIME_ZONE=Europe/Madrid

# ============================================================================
# NOTAS DE DESPLIEGUE EN VERCEL
# ============================================================================
#
# BACKEND (Django API):
# 1. En Vercel, crea un nuevo proyecto con Root Directory = PROYECTO_NEOCORE/neocore/backend
# 2. Configura todas las variables de este .env en Vercel → Settings → Env Vars
# 3. Vercel ejecutará automáticamente build_files.sh (collectstatic)
# 4. Ejecuta las migraciones una vez: vercel exec -- python manage.py migrate
# 5. Crea el superusuario: vercel exec -- python manage.py createsuperuser
#
# FRONTEND (Next.js):
# 1. En Vercel, crea otro proyecto con la raíz del repositorio
# 2. Configura NEXT_PUBLIC_API_URL con la URL del backend (p. ej. https://neocore-api.vercel.app)
#
# BASE DE DATOS (Neon):
# 1. Crea una cuenta en neon.tech
# 2. Crea un proyecto y una base de datos
# 3. Copia la "Connection string" (con ?sslmode=require) como DATABASE_URL
# ============================================================================
