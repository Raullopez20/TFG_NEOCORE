# ==============================
# Core Django
# ==============================
DEBUG=False
SECRET_KEY=replace-with-a-strong-random-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key
LANGUAGE_CODE=es
TIME_ZONE=Europe/Madrid

# ==============================
# Hosts and URLs
# ==============================
ALLOWED_HOSTS=neocoree.xyz,www.neocoree.xyz
BACKEND_PUBLIC_URL=https://api.neocoree.xyz
FRONTEND_URL=https://neocoree.xyz
NEXT_PUBLIC_DOMAIN=https://neocoree.xyz
CORS_ALLOWED_ORIGINS=https://neocoree.xyz,https://www.neocoree.xyz
ADMIN_PATH=secure-admin-8f3x9/
ADMIN_ALLOWED_IPS=127.0.0.1

# ==============================
# Database (choose one strategy)
# ==============================
DATABASE_URL=postgres://user:password@host:5432/dbname
POSTGRES_DB=neocore
POSTGRES_USER=neocore
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================
# Email / SMTP
# ==============================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=no-reply@neocoree.xyz
CONTACT_RECIPIENT_EMAIL=contacto@neocoree.xyz

# ==============================
# OAuth providers
# ==============================
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ==============================
# Celery and Redis
# ==============================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ==============================
# External integrations / API keys
# ==============================
THIRD_PARTY_API_KEY=replace-with-api-key
EXTERNAL_SERVICE_TOKEN=replace-with-token

# ==============================
# Vercel deployment notes
# ==============================
# 1) Vercel dashboard -> Project Settings -> Environment Variables
# 2) Add each variable above in Production (and Preview if needed)
# 3) Redeploy after saving variables
